          "const": "activity_effort",
          "default": "activity_effort",
          "title": "Type",
          "type": "string"
        },
        "activity_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Activity Id",
          "type": "string"
        },
        "perceived_exertion": {
          "maximum": 10,
          "minimum": 0,
          "title": "Perceived Exertion",
          "type": "integer"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "activity_id",
        "perceived_exertion"
      ],
      "title": "ActivityEffort",
      "type": "object"
    },
    "Caffeine": {
