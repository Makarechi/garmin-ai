          "default": null,
          "title": "Dose Notes"
        },
        "caffeine_mg_estimate": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caffeine Mg Estimate"
        },
        "caffeine_mg_min": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caffeine Mg Min"
        },
        "caffeine_mg_max": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caffeine Mg Max"
        }
      },
      "required": [
        "beverage"
      ],
      "title": "Caffeine",
      "type": "object"
    },
    "ContextEvent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "alcohol",
            "meal",
            "hydration",
            "illness",
            "nap",
            "stressor",
            "travel",
            "mood",
            "note",
            "context",
            "caffeine_absence",
            "caffeine_log_complete"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "type",
        "description"
      ],
      "title": "ContextEvent",
      "type": "object"
    },
    "DraftLink": {
      "additionalProperties": false,
      "properties": {
        "child_index": {
          "maximum": 9,
          "minimum": 0,
          "title": "Child Index",
          "type": "integer"
        },
        "parent_index": {
          "maximum": 9,
          "minimum": 0,
          "title": "Parent Index",
          "type": "integer"
        }
      },
      "required": [
        "child_index",
        "parent_index"
