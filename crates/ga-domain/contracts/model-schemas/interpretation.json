  "additionalProperties": false,
  "properties": {
    "intent": {
      "enum": [
        "log",
        "update",
        "close",
        "undo",
        "question",
        "clarify",
        "safety",
        "acknowledge"
      ],
      "title": "Intent",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/EventInput"
      },
      "maxItems": 10,
      "title": "Events",
      "type": "array"
    },
    "draft_links": {
      "items": {
        "$ref": "#/$defs/DraftLink"
      },
      "maxItems": 10,
      "title": "Draft Links",
      "type": "array"
    },
    "target_event_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Event Id"
    },
    "target_question_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Question Id"
    },
    "question_context_ids": {
      "description": "Only offered pending questions whose context is needed to interpret this message; empty for independent messages.",
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 20,
      "title": "Question Context Ids",
      "type": "array"
    },
    "clarification": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Clarification"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "response_language": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9]{1,8}(?:-[A-Za-z0-9]{1,8})*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Language"
    },
    "changed_fields": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Changed Fields",
      "type": "array"
    }
  },
  "required": [
    "intent",
    "confidence"
