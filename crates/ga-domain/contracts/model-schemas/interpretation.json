    "EventInput": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "timezone": {
          "default": "Europe/Bratislava",
          "title": "Timezone",
          "type": "string"
        },
        "source": {
          "default": "manual",
          "enum": [
            "manual",
            "telegram_text",
            "telegram_button",
            "telegram_voice",
            "mcp",
            "inferred",
            "wearable"
          ],
          "title": "Source",
          "type": "string"
        },
        "confidence": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "status": {
          "default": "confirmed",
          "enum": [
            "confirmed",
            "inferred",
            "needs_confirmation"
          ],
          "title": "Status",
          "type": "string"
        },
        "original_text": {
          "anyOf": [
            {
              "maxLength": 16000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Text"
        },
        "payload": {
          "discriminator": {
            "mapping": {
              "activity_effort": "#/$defs/ActivityEffort",
              "alcohol": "#/$defs/ContextEvent",
              "caffeine": "#/$defs/Caffeine",
              "caffeine_absence": "#/$defs/ContextEvent",
              "caffeine_log_complete": "#/$defs/ContextEvent",
              "context": "#/$defs/ContextEvent",
              "headache_observation": "#/$defs/HeadacheObservation",
              "hydration": "#/$defs/ContextEvent",
              "illness": "#/$defs/ContextEvent",
              "meal": "#/$defs/ContextEvent",
              "medication": "#/$defs/Medication",
              "migraine": "#/$defs/Migraine",
              "mood": "#/$defs/ContextEvent",
              "nap": "#/$defs/ContextEvent",
              "note": "#/$defs/ContextEvent",
              "stressor": "#/$defs/ContextEvent",
              "symptom_observation": "#/$defs/SymptomObservation",
              "travel": "#/$defs/ContextEvent",
              "wellbeing_observation": "#/$defs/WellbeingObservation"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Caffeine"
            },
            {
              "$ref": "#/$defs/Migraine"
            },
            {
              "$ref": "#/$defs/Medication"
            },
            {
              "$ref": "#/$defs/ContextEvent"
            },
            {
              "$ref": "#/$defs/HeadacheObservation"
            },
            {
              "$ref": "#/$defs/WellbeingObservation"
            },
            {
              "$ref": "#/$defs/ActivityEffort"
            },
            {
              "$ref": "#/$defs/SymptomObservation"
            }
          ],
          "title": "Payload"
        }
      },
      "required": [
        "start",
        "payload"
      ],
      "title": "EventInput",
      "type": "object"
    },
    "HeadacheObservation": {
