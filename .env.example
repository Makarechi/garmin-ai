# Run uv run python scripts/configure.py to create actual local defaults.
GA_TIMEZONE=Europe/Bratislava
GA_TOKEN_DIR=tokens/garmin
GA_DATA_DIR=data
GA_BACKUP_DIR=backups
GA_POSTGRES_PASSWORD=replace-with-generated-password
GA_DATABASE_URL=postgresql+psycopg://garmin:replace-with-generated-password@127.0.0.1:55432/garmin_ai
GA_CONTAINER_DATABASE_URL=postgresql+psycopg://garmin:replace-with-generated-password@db:5432/garmin_ai
GA_APP_UID=
# configure.py detects the local user and group when these are empty.
GA_APP_GID=
GA_API_KEY=replace-with-a-random-key-at-least-32-characters
# Legacy API key grants admin. Scoped keys can replace it; see docs/access-scopes.md.
GA_API_TOKENS=[]
GA_MCP_ENABLE_WRITES=false
GA_BACKUP_KEY=
GA_TELEGRAM_BOT_TOKEN=
GA_TELEGRAM_USER_ID=0
GA_TELEGRAM_WEBHOOK_SECRET=
GA_GEMINI_API_KEY=
GA_GEMINI_MODEL=
GA_GEMINI_THINKING_LEVEL=
GA_LLM_ENABLED=false
GA_PROACTIVE_ENABLED=false
GA_QUESTION_BUDGET=2
GA_QUIET_START_HOUR=22
GA_QUIET_END_HOUR=8
GA_BACKUP_KEEP_DAILY=14
# Automatic daily history horizon after owner enrollment; 0 disables new planning.
GA_BACKFILL_DAYS=365

# Shared local coordination; keep outside data/token directories.
GA_LOCK_DIR=.state
